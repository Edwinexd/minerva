{
  "db_name": "PostgreSQL",
  "query": "SELECT r.id, r.nrps_context_id, r.ran_at, r.status, r.error, r.warning,\n                  r.added, r.removed\n        FROM lti_nrps_sync_runs r\n        JOIN lti_nrps_contexts c ON c.id = r.nrps_context_id\n        WHERE r.nrps_context_id = $1\n          AND c.course_id = $2\n          AND r.ran_at < $3\n        ORDER BY r.ran_at DESC\n        LIMIT $4",
