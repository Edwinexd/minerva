  "query": "\n        INSERT INTO relink_queue (workspace_id, first_marked_at, due_at)\n        VALUES ($1, NOW(), NOW())\n        ON CONFLICT (workspace_id) DO UPDATE\n            SET due_at = LEAST(relink_queue.due_at, NOW())\n        RETURNING workspace_id, first_marked_at, due_at\n        ",
