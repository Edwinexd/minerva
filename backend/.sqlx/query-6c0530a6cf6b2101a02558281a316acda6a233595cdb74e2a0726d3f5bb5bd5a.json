{
  "db_name": "PostgreSQL",
  "query": "SELECT g.id AS grant_id, g.client_id, c.client_name, g.created_at, g.last_used_at\n           FROM oauth_grants g JOIN oauth_clients c ON c.client_id = g.client_id\n           WHERE g.user_id = $1 AND g.revoked_at IS NULL\n           ORDER BY g.created_at DESC",
