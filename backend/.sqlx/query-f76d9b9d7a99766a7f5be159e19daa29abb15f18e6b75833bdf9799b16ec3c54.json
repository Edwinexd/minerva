  "query": "SELECT nrps_context_id,\n                  COUNT(*) AS \"runs!\",\n                  COALESCE(SUM(added), 0)::bigint AS \"added!\",\n                  COALESCE(SUM(removed), 0)::bigint AS \"removed!\"\n        FROM lti_nrps_sync_runs\n        WHERE nrps_context_id = ANY($1)\n        GROUP BY nrps_context_id",
